<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <RootNamespace>TalepKontrol</RootNamespace>
    <AssemblyName>Talep_Kontrol</AssemblyName>
    <AssemblyTitle>Talep Kontrol Kurulum</AssemblyTitle>
    <AssemblyVersion>6.2.1.0</AssemblyVersion>
    <FileVersion>6.2.1.0</FileVersion>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>Resources\TalepKontrol.ico</ApplicationIcon>
    <PlatformTarget>x86</PlatformTarget>
    <Prefer32Bit>true</Prefer32Bit>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net48" Version="1.0.3" PrivateAssets="all" />
    <PackageReference Include="Microsoft.CSharp" Version="4.7.0" />
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
    <Reference Include="System.Runtime.Serialization" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Resources\TalepKontrol.ico" LogicalName="TalepKontrol.ico" />
    <EmbeddedResource Include="Resources\TalepKontrol_Logo.png" LogicalName="TalepKontrol_Logo.png" />
  </ItemGroup>
</Project>
